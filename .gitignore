# Python 서비스에서 생성되는 비밀값·캐시·로컬 산출물의 추적을 제외한다.
# Python cache
__pycache__/
*.pyc

# OS / editor
.DS_Store
.vscode/

# Raw crawled data
data/raw/*.json
data/raw/*.txt
!data/raw/README.md

# Converted / generated review outputs
data/converted/

# Local databases and generated analysis results
*.db
output/*.json
!output/*_sample.json

# Temporary / broken files
*broken*
*_old_*

# 환경 변수 (비밀번호 등 중요 정보)
.env
.env.*
!.env.example
.venv/
.pytest_cache/
secrets/
docker-compose.override.yml
