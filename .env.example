# 선택적 Google Cloud 감성 분석: 컨테이너 내부의 인증 파일 경로.
# 미설정하면 기존 규칙 기반 점수만 계산한다.
# ENABLE_CLOUD_NLP는 기존 코드에서 사용하지 않으므로 제공하지 않는다.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-credentials.json

# AI 자체 결과 저장 파일. Docker Compose는 전용 named volume 경로를 사용한다.
AI_RESULT_DB_PATH=data/ai-results.db
# 공개 계약과 인증 확정 전에는 아래 기능을 운영 환경에서 켜지 않는다.
ENABLE_EXPERIMENTAL_COLLECTION=0
ALLOW_LEGACY_CRAWLER_DEFAULTS=0
# 실험 시 실제 크롤러 서비스 주소를 명시한다 (우리 AI 서버 주소가 아님).
# CRAWLER_BASE_URL=http://crawler:8000
# CRAWLER_STREAM_TIMEOUT=60
# CRAWLER_MAX_RETRIES=0
